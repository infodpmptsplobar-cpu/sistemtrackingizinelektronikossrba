<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Google Sheets</title>
    
    <!-- Library Chart.js untuk Grafik -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Library PapaParse untuk konversi CSV ke JSON -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            background-color: #f4f6f9;
            color: #333;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
        }
        .card {
            background: #fff;
            padding: 20px;
            margin-bottom: 25px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        h2 {
            margin-top: 0;
            color: #2c3e50;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #007bff;
            color: white;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        .chart-container {
            position: relative;
            height: 400px;
            width: 100%;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Visualisasi Grafik -->
    <div class="card">
        <h2>Grafik Data</h2>
        <div class="chart-container">
            <canvas id="myChart"></canvas>
        </div>
    </div>

    <!-- Visualisasi Tabel -->
    <div class="card">
        <h2>Tabel Data</h2>
        <div style="overflow-x: auto;">
            <table id="dataTable">
                <thead>
                    <tr id="tableHead"></tr>
                </thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // Ganti URL di bawah ini dengan Link Publikasi CSV Google Sheets Anda
    const CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vR_EXAMPLE_URL_HERE/pub?output=csv';

    async function loadSpreadsheetData() {
        try {
            const response = await fetch(CSV_URL);
            const csvText = await response.text();

            // Parse data CSV ke bentuk JSON Array
            Papa.parse(csvText, {
                header: true,
                skipEmptyLines: true,
                complete: function(results) {
                    const data = results.data;
                    const headers = results.meta.fields;

                    if (data.length === 0) return;

                    renderTable(headers, data);
                    renderChart(headers, data);
                }
            });
        } catch (error) {
            console.error('Gagal mengambil data dari Google Sheets:', error);
        }
    }

    // Fungsi Render Tabel secara Otomatis mengikuti Kolom
    function renderTable(headers, data) {
        const tableHead = document.getElementById('tableHead');
        const tableBody = document.getElementById('tableBody');

        tableHead.innerHTML = '';
        tableBody.innerHTML = '';

        // Header Tabel
        headers.forEach(header => {
            const th = document.createElement('th');
            th.textContent = header;
            tableHead.appendChild(th);
        });

        // Baris Data Tabel
        data.forEach(row => {
            const tr = document.createElement('tr');
            headers.forEach(header => {
                const td = document.createElement('td');
                td.textContent = row[header] || '';
                tr.appendChild(td);
            });
            tableBody.appendChild(tr);
        });
    }

    // Fungsi Render Grafik (Mengambil Kolom Pertama sebagai Label, Kolom Kedua sebagai Nilai)
    function renderChart(headers, data) {
        const labelKey = headers[0]; // Kolom ke-1 sebagai Label X
        const valueKey = headers[1]; // Kolom ke-2 sebagai Nilai Y

        const labels = data.map(item => item[labelKey]);
        const values = data.map(item => parseFloat(item[valueKey]) || 0);

        const ctx = document.getElementById('myChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar', // Tipe grafik: 'bar', 'line', 'pie', dll.
            data: {
                labels: labels,
                datasets: [{
                    label: valueKey,
                    data: values,
                    backgroundColor: 'rgba(0, 123, 255, 0.6)',
                    borderColor: 'rgba(0, 123, 255, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    }

    // Jalankan fungsi saat halaman selesai dimuat
    loadSpreadsheetData();
</script>

</body>
</html>
